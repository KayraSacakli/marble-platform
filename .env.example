# Database
DATABASE_URL="postgresql://user:password@localhost:5432/marble_platform_dev?schema=public"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here"

# Site URL (used for canonical URLs, sitemap, and metadataBase).
# Production validation (src/lib/env.ts) REJECTS placeholder hosts like
# example.com — in production set your real public origin, e.g.
# NEXT_PUBLIC_SITE_URL="https://www.yourdomain.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# CMS (Phase 3+)
CMS_API_URL=""
CMS_API_KEY=""

# Admin seed (development only, min 12 chars; never use in production)
SEED_ADMIN_PASSWORD="Admin123!ChangeMe"

# Content import script (scripts/import-content.ts) — used with --execute only
IMPORT_BASE_URL="http://localhost:3000"
IMPORT_ADMIN_EMAIL=""
IMPORT_ADMIN_PASSWORD=""
